<Window x:Class="NotchUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchUser" Width="560" Height="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">

    <Window.Resources>
        <!-- Round icon button: Segoe Fluent glyph, soft circle on hover. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The "notch": hangs from the top edge, grows on hover. -->
        <Border x:Name="Notch" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="150" Height="20" CornerRadius="0,0,14,14"
                Background="#F50B0B0F" BorderBrush="#24FFFFFF" BorderThickness="1,0,1,1"
                ClipToBounds="True" AllowDrop="True" RenderTransformOrigin="0.5,0" Margin="0,0,0,24">
            <Border.RenderTransform>
                <ScaleTransform x:Name="NotchScale"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <!-- Collapsed: cover, title, bars (or shelf count) -->
                <Grid x:Name="Collapsed" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PillCover" Width="20" Height="20" CornerRadius="5" Background="#22FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PillTitle" Grid.Column="1" Margin="8,0" Foreground="#EBFFFFFF" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="PillBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel x:Name="PillShelf" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="#D9FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillShelfCount" Margin="5,0,0,0" Foreground="#D9FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Expanded panel -->
                <StackPanel x:Name="Expanded" Margin="22,14,22,12" Visibility="Collapsed">
                    <StackPanel x:Name="MediaSection">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BigCover" Width="58" Height="58" CornerRadius="14" Background="#22FFFFFF" Cursor="Hand"/>
                            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Foreground="#99FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="BigBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                            <Grid x:Name="Track" Grid.Column="1" Height="14" Margin="6,0" Background="Transparent" Cursor="Hand">
                                <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                                <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="#D9FFFFFF"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" Foreground="#80FFFFFF" FontSize="11"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"/>
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                        FontSize="24" Width="48" Height="48" Margin="10,0"/>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"/>
                            </StackPanel>
                            <StackPanel x:Name="Sources" Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Rectangle x:Name="Hairline" Height="1" Margin="0,10" Fill="#1FFFFFFF"/>

                    <Grid x:Name="ShelfSection" Height="84">
                        <Border x:Name="ShelfWell" CornerRadius="16" Background="#0DFFFFFF" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ShelfItems" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <Button x:Name="TrashButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                        Content="&#xE74D;" FontSize="14" Width="30" Height="30" Foreground="#80FFFFFF"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="DropZone" Visibility="Collapsed">
                            <Rectangle x:Name="DropRect" RadiusX="16" RadiusY="16" Stroke="#59FFFFFF" StrokeThickness="1.4"
                                       StrokeDashArray="5 4" Fill="#0DFFFFFF"/>
                            <TextBlock x:Name="DropText" Foreground="#CCFFFFFF" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="EmptySection" Height="58" VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle" Foreground="#8CFFFFFF" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock x:Name="EmptyHint" Foreground="#59FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
