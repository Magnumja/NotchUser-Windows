<Window x:Class="NotchUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotchUser"
        Title="NotchUser" Width="500" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Everything is laid out at 100% and scaled as a whole by the Size setting. Just big enough for the
         open notch: the window is transparent, and Windows copies all of it on every frame. -->
    <Grid x:Name="Root" Width="500" Height="270" VerticalAlignment="Top" HorizontalAlignment="Center">

        <!-- While something is carried toward the top, this almost invisible area (1/255 opaque)
             catches the drag, so the notch opens before the file reaches the edge. -->
        <Rectangle x:Name="DragCatcher" Width="480" Height="220" VerticalAlignment="Top" Fill="#01000000"
                   AllowDrop="True" Visibility="Collapsed"/>

        <!-- The notch and what hangs around it: glow, shadows, rim. Grows from the top center. -->
        <Grid x:Name="NotchHost" HorizontalAlignment="Center" VerticalAlignment="Top" Width="130" Height="28"
              RenderTransformOrigin="0.5,0" AllowDrop="True">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BumpScale"/>
                    <ScaleTransform x:Name="LiftScale"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- The notch itself, clipped to the notch outline. -->
            <Grid x:Name="Notch" Background="Transparent">
                <!-- Expanded backdrop: vivid black, with the album's color rising from the bottom. -->
                <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False">
                    <Rectangle Fill="Black"/>
                    <Rectangle x:Name="AccentGlow" Opacity="0.55">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop x:Name="GlowTop" Color="#00000000" Offset="0.3"/>
                                <GradientStop x:Name="GlowBottom" Color="#FF1E4FD8" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Collapsed: pure black, it has to look like part of the screen's edge. -->
                <Rectangle x:Name="CollapsedBlack" Fill="Black" IsHitTestVisible="False"/>

                <!-- Collapsed content: cover on the left, bars on the right. -->
                <Grid x:Name="Collapsed" Height="28" VerticalAlignment="Top" Margin="13,0" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PillLeft" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PillLyric" Grid.Column="1" Margin="10,0" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="#CCFFFFFF" Visibility="Collapsed"/>
                    <Grid x:Name="PillRight" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>

                <!-- Privacy dot at the right end of the closed notch: green while the camera is in use,
                     orange for the microphone (as on the Mac). -->
                <Ellipse x:Name="PrivacyDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,11,7,0" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Expanded content: sections stacked (music, shelf), split by hairlines. -->
                <StackPanel x:Name="Expanded" Width="422" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,32,0,10" Visibility="Collapsed" RenderTransformOrigin="0.5,0"/>

            </Grid>

            <!-- A hairline that brightens toward the bottom (black at the top), so the open notch reads on dark wallpapers. -->
            <Path x:Name="RimLine" StrokeThickness="1" Opacity="0" IsHitTestVisible="False">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop x:Name="RimMid" Color="#1AFFFFFF" Offset="0.35"/>
                        <GradientStop x:Name="RimEnd" Color="#47FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>
    </Grid>
</Window>
