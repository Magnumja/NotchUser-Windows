<Window x:Class="NotchUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotchUser"
        Title="NotchUser" Width="680" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Everything is laid out at 100% and scaled as a whole by the Size setting. -->
    <Grid x:Name="Root" Width="680" Height="360" VerticalAlignment="Top" HorizontalAlignment="Center">

        <!-- While something is carried toward the top, this almost invisible area (1/255 opaque)
             catches the drag, so the notch opens before the file reaches the edge. -->
        <Rectangle x:Name="DragCatcher" Width="640" Height="220" VerticalAlignment="Top" Fill="#01000000"
                   AllowDrop="True" Visibility="Collapsed"/>

        <!-- The notch and what hangs around it: glow, shadows, rim. Grows from the top center. -->
        <Grid x:Name="NotchHost" HorizontalAlignment="Center" VerticalAlignment="Top" Width="130" Height="28"
              RenderTransformOrigin="0.5,0" AllowDrop="True">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BumpScale"/>
                    <ScaleTransform x:Name="LiftScale"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Elevated and Glass: while playing, a soft light in the album's color under the closed notch. -->
            <Rectangle x:Name="UnderGlow" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"
                       Margin="0,0,0,-4.5" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Effect>
                    <BlurEffect Radius="8"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- Shadows, cut out where the notch is so they never darken the glass. -->
            <Grid x:Name="ShadowLayer" IsHitTestVisible="False">
                <Path x:Name="AmbientShadow" Fill="Black" Opacity="0">
                    <Path.Effect>
                        <DropShadowEffect x:Name="AmbientEffect" Direction="270" ShadowDepth="20" BlurRadius="60" Opacity="0.35" RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>
                <Path x:Name="NearShadow" Fill="Black" Opacity="0">
                    <Path.Effect>
                        <DropShadowEffect x:Name="NearEffect" Direction="270" ShadowDepth="8" BlurRadius="36" Opacity="0.45" RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>
                <Path x:Name="Halo" Fill="Black" Opacity="0">
                    <Path.Effect>
                        <DropShadowEffect x:Name="HaloEffect" ShadowDepth="0" BlurRadius="48" Opacity="1" Color="White" RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>
            </Grid>

            <!-- The notch itself, clipped to the notch outline. -->
            <Grid x:Name="Notch" Background="Transparent">
                <!-- Expanded backdrop: dark frosted surface tinted by the cover, black at the top. -->
                <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False">
                    <Rectangle x:Name="BackdropFill" Fill="#F21C1C1F"/>
                    <Rectangle x:Name="BackdropDim" Fill="#47000000"/>
                    <Image x:Name="BackdropArt" Width="470" Height="290" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Stretch="UniformToFill" Opacity="0.4">
                        <Image.Effect>
                            <BlurEffect Radius="100" RenderingBias="Performance" KernelType="Gaussian"/>
                        </Image.Effect>
                        <Image.CacheMode>
                            <BitmapCache/>
                        </Image.CacheMode>
                    </Image>
                    <Rectangle x:Name="ElevatedSheen" Visibility="Collapsed">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.5">
                                <GradientStop Color="#0FFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="GlassSheen" Visibility="Collapsed">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <local:FlowingWavesView x:Name="Waves" Width="470" Height="100" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Visibility="Collapsed"/>
                    <!-- Solid black where the notch meets the top edge, fading out 28 px below it. -->
                    <Rectangle Height="56" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Collapsed: pure black, it has to look like part of the screen's edge. -->
                <Rectangle x:Name="CollapsedBlack" Fill="Black" IsHitTestVisible="False"/>

                <!-- Collapsed content: cover on the left, bars on the right. -->
                <Grid x:Name="Collapsed" Height="28" VerticalAlignment="Top" Margin="13,0" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PillLeft" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PillLyric" Grid.Column="1" Margin="10,0" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="#CCFFFFFF" Visibility="Collapsed"/>
                    <Grid x:Name="PillRight" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>

                <!-- Expanded content: sections stacked (music, shelf), split by hairlines. -->
                <StackPanel x:Name="Expanded" Width="422" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,32,0,10" Visibility="Collapsed" RenderTransformOrigin="0.5,0"/>

                <!-- Glass rim, part 1: a soft inner glow along the edge. -->
                <Path x:Name="RimGlow" StrokeThickness="8" Stroke="#1AFFFFFF" Opacity="0" IsHitTestVisible="False">
                    <Path.Effect>
                        <BlurEffect Radius="12" RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>
            </Grid>

            <!-- Glass rim, part 2: a hairline that brightens toward the bottom (black at the top). -->
            <Path x:Name="RimLine" StrokeThickness="1" Opacity="0" IsHitTestVisible="False">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop x:Name="RimMid" Color="#1AFFFFFF" Offset="0.35"/>
                        <GradientStop x:Name="RimEnd" Color="#47FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>
    </Grid>
</Window>
