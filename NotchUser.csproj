<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ SDK: gives access to the system media controls API. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the project be compiled (not run) on macOS/Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NotchUser</AssemblyName>
    <RootNamespace>NotchUser</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.15.0</Version>
    <Product>NotchUser</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lighter on memory: no background GC thread, and only the UI languages we ship. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en;pt;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests live in their own project, beside the app. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brightness changes from the laptop's keys (WMI). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
